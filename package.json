{
  "name": "@yuez/pi2d",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "description": "pi2 web console daemon (`pi2 daemon`): HTTP/WS gateway, workspace registry and instance supervisor for pi2.nvim",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi2": "./dist/cli/pi2.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "docs/protocol.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgs225/pi2d.git"
  },
  "homepage": "https://github.com/zgs225/pi2d#readme",
  "bugs": {
    "url": "https://github.com/zgs225/pi2d/issues"
  },
  "keywords": [
    "pi",
    "neovim",
    "coding-agent",
    "web-console",
    "daemon"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/pi2.ts daemon",
    "build": "tsc -p tsconfig.json",
    "build:web": "pnpm --dir web build",
    "prepack": "npm run build && npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/pi2.js daemon --foreground",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
