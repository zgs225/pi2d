{
  "name": "pi2-web-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi2 web console daemon (`pi2 daemon`): HTTP/WS gateway, workspace registry and instance supervisor for pi2.nvim",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi2": "./dist/cli/pi2.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/pi2.ts daemon",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/pi2.js daemon --foreground",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
